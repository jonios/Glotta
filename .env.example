# Glotta configuration. Copy to .env and adjust. Never commit .env.

# ── Database (PostgreSQL 14+, required) ─────────────────────────────────────
# "npm run pg:init" writes these two lines for you with a random password (local portable PostgreSQL).
DATABASE_URL=postgres://glotta:change-me@127.0.0.1:5432/glotta
# Only for "npm test": a database the role can connect to; the role needs CREATEDB.
TEST_DATABASE_URL=postgres://glotta:change-me@127.0.0.1:5432/glotta_test
# Folder that contains bin/pg_dump and bin/pg_restore, if they are not on PATH.
# PG_HOME=

# ── Server ──────────────────────────────────────────────────────────────────
API_PORT=3001
# 127.0.0.1 = this machine only (use with a reverse proxy); 0.0.0.0 = reachable from the network
HOST=127.0.0.1
NODE_ENV=development
# Public address of the web app, used to build invitation links
APP_URL=http://localhost:5173
# Secure cookie flag: true behind HTTPS, false on plain http (defaults to true when NODE_ENV=production)
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# ── Imports ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=./.data/uploads
MAX_UPLOAD_MB=25
IMPORT_UPLOADS_PER_MINUTE=20

# ── Backups (pg_dump) ───────────────────────────────────────────────────────
BACKUP_DIR=./.data/backups
# Hours between automatic backups; 0 turns them off
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# ── AI translation (optional) ───────────────────────────────────────────────
# Without a key the app works normally and the AI features show setup instructions.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Optional cheaper model offered as the "economy" tier
# ANTHROPIC_MODEL_ECONOMY=
# Optional prices (USD per million tokens) to show cost estimates
# AI_PRICE_INPUT_PER_MTOK=
# AI_PRICE_OUTPUT_PER_MTOK=
# AI_ECONOMY_PRICE_INPUT_PER_MTOK=
# AI_ECONOMY_PRICE_OUTPUT_PER_MTOK=
# Jobs with at least this many keys may use the Message Batches API (0 = never)
# AI_MESSAGE_BATCH_MIN_KEYS=2000
